{
  "name": "@junqi/openclaw-dingtalk-business",
  "version": "0.27.0",
  "description": "OpenClaw-owned DingTalk business tools backed by DWS",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "validate:plugin": "npm run build && node scripts/validate-package.mjs",
    "verify:target-readonly": "npm run build && node scripts/verify-target-readonly.mjs",
    "verify:target-sensitive-readonly": "npm run build && node scripts/verify-target-sensitive-readonly.mjs",
    "verify:target-event": "npm run build && node scripts/verify-target-event.mjs",
    "verify:target-minutes": "npm run build && node scripts/verify-target-minutes.mjs",
    "verify:target-calendar": "npm run build && node scripts/verify-target-calendar.mjs",
    "verify:target-todo": "npm run build && node scripts/verify-target-todo.mjs",
    "verify:target-approval": "npm run build && node scripts/verify-target-approval.mjs",
    "verify:target-report": "npm run build && node scripts/verify-target-report.mjs",
    "pack:plugin": "npm run validate:plugin && node scripts/pack-plugin.mjs",
    "prepack": "npm run validate:plugin"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": "2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  },
  "devDependencies": {
    "openclaw": "2026.8.1"
  }
}
